# Copy to .env (gitignored) and fill in installation-specific values.
# These are consumed by docker-compose.yml and by the native CLI server.

# REQUIRED: the panel code every session logs in with (status, arming, PG
# control, reads). The server will refuse to start in live mode without
# this. Replace with your installation's actual code.
JABLOTRON_PANEL_AUTH_CODE=YOUR_PANEL_CODE

# Optional: a second code used only for user create/edit/delete. Leave unset
# to write with JABLOTRON_PANEL_AUTH_CODE. A master-rights code writes over
# HID; a service- or ARC-rights code writes through IMPORT.CFG (needs the
# FLEXI_CFG block device and a mount).
# JABLOTRON_PANEL_WRITE_AUTH_CODE=YOUR_SECOND_PANEL_CODE

# Optional: how user records reach the panel. "auto" (default) logs in once
# before each write, reads the rights the panel grants the code, and uses
# "hid" for master rights or "storage" (IMPORT.CFG) for service/ARC rights.
# Set "hid" or "storage" to skip the probe and force one path.
# JABLOTRON_PANEL_WRITE_TRANSPORT=auto

# Optional: runtime mode. "live" connects to the real panel via USB/FLEXI;
# "demo" runs an in-memory fake suitable for client smoke tests without
# panel hardware.
# JABLOTRON_API_RUNTIME_MODE=live

# Optional: host-side device paths. Most installations auto-detect; set
# these if auto-detection does not find your panel.
# JABLOTRON_PANEL_PORT=/dev/hidraw0
# JABLOTRON_PANEL_FLEXI_CFG_DEVICE=/dev/sdb1
# JABLOTRON_PANEL_FLEXI_LOG_DEVICE=/dev/sdc1

# Optional: host-side device paths to bind into the container. Default
# values in docker-compose.yml assume /dev/hidraw0, /dev/sdb1, /dev/sdc1.
# JABLOTRON_PANEL_PORT_HOST=/dev/hidraw0
# JABLOTRON_PANEL_FLEXI_CFG_HOST=/dev/sdb1
# JABLOTRON_PANEL_FLEXI_LOG_HOST=/dev/sdc1
