# Production-style compose. Set installation-specific values in a sibling
# .env file (see .env.example) rather than editing this file. The required
# variables are listed there with explanations.
services:
  jablotron-api:
    build: .
    image: jablotron-api-server:latest
    restart: unless-stopped
    environment:
      JABLOTRON_API_DB_PATH: /data/jablotron-api.db
      JABLOTRON_API_PORT: "8443"
      JABLOTRON_API_TLS_CERTFILE: /data/certs/server.crt
      JABLOTRON_API_TLS_KEYFILE: /data/certs/server.key
      JABLOTRON_API_TLS_CA_CERTS: /data/certs/ca.crt
      # Required in live mode. Set in .env (gitignored).
      JABLOTRON_PANEL_AUTH_CODE: "${JABLOTRON_PANEL_AUTH_CODE:?must be set in .env for live mode}"
      # Optional: a second code used only for user writes. Defaults to
      # JABLOTRON_PANEL_AUTH_CODE when unset.
      JABLOTRON_PANEL_WRITE_AUTH_CODE: "${JABLOTRON_PANEL_WRITE_AUTH_CODE:-}"
      # auto | hid | storage. "auto" follows the rights the panel grants the
      # write code: master rights write over HID, service/ARC rights through
      # IMPORT.CFG (which needs the block device below and a mount).
      JABLOTRON_PANEL_WRITE_TRANSPORT: "${JABLOTRON_PANEL_WRITE_TRANSPORT:-auto}"
      # HID writes and catalog reads run inside the status session; "false"
      # rolls back to separate logins.
      JABLOTRON_PANEL_IN_SESSION_CONFIG_OPS: "${JABLOTRON_PANEL_IN_SESSION_CONFIG_OPS:-true}"
      # Max age (s, from pull start) of the cached user table a write may be
      # validated against; 0 = always pull before a write.
      JABLOTRON_PANEL_WRITE_PREFLIGHT_MAX_AGE_SECONDS: "${JABLOTRON_PANEL_WRITE_PREFLIGHT_MAX_AGE_SECONDS:-60}"
      JABLOTRON_PANEL_PORT: "${JABLOTRON_PANEL_PORT:-auto}"
      JABLOTRON_PANEL_FLEXI_CFG_DEVICE: "${JABLOTRON_PANEL_FLEXI_CFG_DEVICE:-auto}"
      JABLOTRON_PANEL_FLEXI_LOG_DEVICE: "${JABLOTRON_PANEL_FLEXI_LOG_DEVICE:-auto}"
      # User writes stage IMPORT.CFG through a mount of FLEXI_CFG (the panel
      # refuses raw sector writes and ignores them even when they land), so
      # the container needs mount(2): see cap_add and security_opt below.
      JABLOTRON_PANEL_STAGE_MODE: "filesystem"
    volumes:
      - ./data:/data
    # mount(2) for user writes: CAP_SYS_ADMIN, and an AppArmor profile that
    # allows mount (docker-default denies it). The container already runs as
    # root with raw access to the panel devices; this adds only the mount.
    cap_add:
      - SYS_ADMIN
    security_opt:
      - apparmor:unconfined
    device_cgroup_rules:
      - "c 13:* rmw"
      - "b *:* rmw"
    devices:
      - "${JABLOTRON_PANEL_PORT_HOST:-/dev/hidraw0}:${JABLOTRON_PANEL_PORT_HOST:-/dev/hidraw0}"
      - "${JABLOTRON_PANEL_FLEXI_CFG_HOST:-/dev/sdb1}:${JABLOTRON_PANEL_FLEXI_CFG_HOST:-/dev/sdb1}"
      - "${JABLOTRON_PANEL_FLEXI_LOG_HOST:-/dev/sdc1}:${JABLOTRON_PANEL_FLEXI_LOG_HOST:-/dev/sdc1}"
    ports:
      - "8443:8443"
