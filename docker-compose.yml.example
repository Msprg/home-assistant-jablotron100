# Production-style compose. Set installation-specific values in a sibling
# .env file (see .env.example) rather than editing this file. The required
# variables are listed there with explanations.
services:
  jablotron-api:
    build: .
    image: jablotron-api-server:latest
    restart: unless-stopped
    environment:
      JABLOTRON_API_DB_PATH: /data/jablotron-api.db
      JABLOTRON_API_PORT: "8443"
      JABLOTRON_API_TLS_CERTFILE: /data/certs/server.crt
      JABLOTRON_API_TLS_KEYFILE: /data/certs/server.key
      JABLOTRON_API_TLS_CA_CERTS: /data/certs/ca.crt
      # Required in live mode. Set in .env (gitignored).
      JABLOTRON_PANEL_AUTH_CODE: "${JABLOTRON_PANEL_AUTH_CODE:?must be set in .env for live mode}"
      JABLOTRON_PANEL_PORT: "${JABLOTRON_PANEL_PORT:-auto}"
      JABLOTRON_PANEL_FLEXI_CFG_DEVICE: "${JABLOTRON_PANEL_FLEXI_CFG_DEVICE:-auto}"
      JABLOTRON_PANEL_FLEXI_LOG_DEVICE: "${JABLOTRON_PANEL_FLEXI_LOG_DEVICE:-auto}"
      # User writes stage the import sector by writing it at its LBA. The
      # default "filesystem" mode mounts FLEXI_CFG, which needs CAP_SYS_ADMIN
      # and does not work in a container.
      JABLOTRON_PANEL_STAGE_MODE: "direct"
    volumes:
      - ./data:/data
    device_cgroup_rules:
      - "c 13:* rmw"
      - "b *:* rmw"
    devices:
      - "${JABLOTRON_PANEL_PORT_HOST:-/dev/hidraw0}:${JABLOTRON_PANEL_PORT_HOST:-/dev/hidraw0}"
      - "${JABLOTRON_PANEL_FLEXI_CFG_HOST:-/dev/sdb1}:${JABLOTRON_PANEL_FLEXI_CFG_HOST:-/dev/sdb1}"
      - "${JABLOTRON_PANEL_FLEXI_LOG_HOST:-/dev/sdc1}:${JABLOTRON_PANEL_FLEXI_LOG_HOST:-/dev/sdc1}"
    ports:
      - "8443:8443"
